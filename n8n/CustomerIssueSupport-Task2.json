    {
      "parameters": {
        "jsCode": "// Get all email items from Gmail Trigger\nconst emails = $('Gmail Trigger').all();\n\n// Map through each email and format a Slack message\nreturn emails.map(email => {\n  const data = email.json;\n  \n\n  const from = $('Gmail Trigger').first().json.headers.from || \"Unknown Sender\";\n  const subject = data.subject || data.Subject || \"No Subject\";\n  const snippet = data.text || \"(No message preview available)\";\n  const TicketRef = $input.first().json.ticketReference\n\n  // Format Slack message text\n  const slackMessage = `\n*📨 New Email Alert!*\n* Ticket : ${TicketRef}\n*From:* ${from}\n*Subject:* ${subject}\n\n*Snippet:*\n${snippet}\n`;\n  // Return each item as a separate object\n  return {\n    json: {\n      text: slackMessage,\n      from,\n      subject,\n      snippet\n    }\n  };\n});"
      },
